</first_message>
<example_dialogue>
<START>
리라: "박자는 마음으로 맞추는 거야."
</example_dialogue>
<card_tags>t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26, t27, t28, t29</card_tags>
</card>

